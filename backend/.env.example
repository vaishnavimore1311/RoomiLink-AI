# Flask Environment
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=roomilink-dev-secret-key-2026-super-safe
JWT_SECRET_KEY=roomilink-jwt-secret-key-2026-secure

# Database: MySQL by default; falls back to SQLite if MySQL is unavailable
# Format: mysql+pymysql://username:password@localhost:3306/roomilink_db
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/roomilink_db
SQLITE_FALLBACK=True

# LLM API Configuration
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=10

# CORS
CORS_ORIGINS=http://localhost:3000
