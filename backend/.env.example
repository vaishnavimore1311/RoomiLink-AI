# Flask Environment
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=roomilink-dev-secret-key-2026-super-safe
JWT_SECRET_KEY=roomilink-jwt-secret-key-2026-secure

# Database Configuration (Shared Cloud MySQL or Local SQLite)
# Option A - TiDB Cloud Serverless (Recommended, 5GB Free, No Credit Card):
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:4000/<database_name>?ssl_verify_cert=true
#
# Option B - Aiven for MySQL (5GB Free):
# DATABASE_URL=mysql+pymysql://avnadmin:<password>@<host>:<port>/defaultdb?ssl-mode=REQUIRED
#
# Option C - Local SQLite Fallback:
# DATABASE_URL=sqlite:///instance/roomilink_dev.db
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/roomilink_db
SQLITE_FALLBACK=True


# Razorpay Payment Gateway (Demo / Test Mode)
RAZORPAY_KEY_ID=rzp_test_RoomiLinkDemo2026
RAZORPAY_KEY_SECRET=roomilink_secret_demo_key_9988

# LLM API Configuration
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=10

# CORS
CORS_ORIGINS=http://localhost:3000

